# Frontend Environment Configuration
# Copy to .env.local for local overrides.

# 1. Backend API Base URL
# - For local development: http://localhost:8000
# - For cloud production: https://your-backend.railway.app (or render.com / aws)
# - If left empty and backend is unreachable, frontend automatically falls back to Demo Data.
VITE_API_BASE_URL=http://localhost:8000

# 2. Force Demo Mode (true | false)
# - Set to 'true' to explicitly bypass all network requests and use local mock data.
VITE_USE_MOCK_DATA=false
