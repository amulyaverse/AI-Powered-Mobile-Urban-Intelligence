# ==============================================================================
# Environment Configuration — AI-Powered Mobile Urban Intelligence Platform
# Copy this file to .env (or backend/.env) and configure for your environment.
# NEVER commit the actual .env file with secrets into version control.
# ==============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite fallback (default):
DATABASE_URL=sqlite:///./urban_intelligence.db

# Production PostgreSQL (OCI VM / Self-hosted / Managed):
# DATABASE_URL=postgresql://urban_app:your_secure_password@127.0.0.1:5432/urban_intelligence

# ── Application Settings ──────────────────────────────────────────────────────
APP_NAME=AI-Powered Mobile Urban Intelligence API
APP_VERSION=1.0.0
DEBUG=false
AUTO_SEED=false

# ── CORS Configuration ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Include your Vercel deployment URL:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://ai-powered-mobile-urban-intelligenc.vercel.app

# ── Ingestion & Hotspot Settings ──────────────────────────────────────────────
MIN_CONFIDENCE=0.65
HOTSPOT_RADIUS_METRES=50.0
HOTSPOT_ALERT_THRESHOLD=3
AGGREGATOR_SUPPRESS_WINDOW_SEC=2.0
AGGREGATOR_CONF_OVERRIDE_DELTA=0.15

# ── Edge AI & YOLO Inference ──────────────────────────────────────────────────
# Path to model weights (relative to repository root or absolute):
YOLO_POTHOLE_WEIGHTS=edge-ai/pothole-latest/Pothole_Road_Condition_Model/best_2.pt
YOLO_TRAFFIC_WEIGHTS=yolov8n.pt

# Inference thresholds:
INFERENCE_CONFIDENCE=0.25
INFERENCE_CONFIDENCE_POTHOLE=0.45
INFERENCE_IOU=0.45

# ── WebSocket & Streaming FPS ─────────────────────────────────────────────────
DETECTION_FPS_POTHOLE=5.0
DETECTION_FPS_TRAFFIC=5.0
WS_FRAME_SAMPLE_INTERVAL_SEC=0.2
WS_MAX_FRAME_SIZE_BYTES=512000

# ── Target Bus & Simulated Vicinity ───────────────────────────────────────────
TARGET_BUS_ID=BUS_021
BUS_VICINITY_RADIUS_KM=3.0
