# .env — Local development configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to Git.

# ── Database ──────────────────────────────────────────────────────────────────
# For local development (SQLite — no setup required):
DATABASE_URL=sqlite:///./urban_intelligence.db

# For managed cloud DB (uncomment and fill in your connection string):
# DATABASE_URL=postgresql://user:password@host:5432/urban_intelligence

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Add your frontend origins (comma-separated, no spaces)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://ai-powered-mobile-urban-intelligenc.vercel.app
